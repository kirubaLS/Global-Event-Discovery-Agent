# frontend/.env.example - copy to frontend/.env for local dev.
# On Render (Static Site), set this in Environment, then
# "Clear build cache & deploy" - VITE_ vars are baked in at BUILD time.

# The backend's URL, no trailing slash.
# Local dev:  http://localhost:8000
# Production: https://event-agent-backend.onrender.com  (your backend service URL)
VITE_API_URL=http://localhost:8000
