# ─────────────────────────────────────────────────────────────────────
# backend/.env.example — copy to backend/.env for local dev.
# On Render, set these in Dashboard → your backend service → Environment.
# ─────────────────────────────────────────────────────────────────────

# ── REQUIRED: ChatGPT real web search (the entire event pipeline) ────
# platform.openai.com → API keys. Without it /api/search returns 503.
OPENAI_API_KEY=
# Must support the Responses API web_search tool; leave the default.
OPENAI_SEARCH_MODEL=gpt-5

# ── OPTIONAL: lead capture / tracking (Neon Postgres) ────────────────
# neon.tech → your project → Dashboard → "Connection string".
# Tables auto-create on first use. Unset = nothing is stored (searches
# still work, but you lose leads, submissions, results, sessions).
# Format: postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── OPTIONAL: Upstash Redis (search cache + daily rate limit) ────────
# console.upstash.com → your database → "Redis URL (TLS)". Note the
# double-s rediss:// scheme. Unset = no cache and NO rate limit (every
# search hits OpenAI and costs money — recommended to set this).
# Format: rediss://default:PASSWORD@xxx.upstash.io:6379
REDIS_URL=
# Searches allowed per device/IP per UTC day (0 disables the limit).
SEARCH_DAILY_LIMIT=3
# Identical ICP search within this window reuses the cached result
# instead of a new OpenAI call. 86400 = 24 hours.
SEARCH_CACHE_TTL_SECONDS=86400

# ── OPTIONAL: OTP verification via Brevo HTTP API (USE THIS ON RENDER) ─
# Render's FREE tier blocks outbound SMTP ports entirely ("[Errno 101]
# Network is unreachable") — the Brevo HTTP API goes over port 443 and
# works everywhere. brevo.com (300 emails/day free) → SMTP & API → API
# keys → create a v3 API key. Verify your sender under Senders & IPs.
BREVO_API_KEY=
BREVO_FROM_EMAIL=verify@expotofunnel.com

# ── OPTIONAL: OTP verification emails via plain SMTP ─────────────────
# ⚠ Does NOT work on Render free tier (SMTP ports blocked) — use the
# Brevo API above there. SMTP works locally / on paid hosts.
# When SMTP_HOST is set, the 6-digit verification codes go over SMTP
# and Resend is used ONLY for the PDF report. Free options:
#   Google Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=587
#     SMTP_USER=you@yourdomain.com  SMTP_PASS=<16-char App Password>
#     (myaccount.google.com → Security → 2-Step Verification → App passwords)
#   Brevo (300 emails/day free): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#     SMTP_USER=<your Brevo login>  SMTP_PASS=<SMTP key from dashboard>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address for OTP mails; defaults to SMTP_USER when empty.
SMTP_FROM=

# ── OPTIONAL: email PDF report (Resend) ──────────────────────────────
# resend.com → API keys. Without it /api/email-report returns 503
# (search itself is unaffected).
RESEND_API_KEY=
# Must be a sender on a domain you verified in Resend.
RESEND_FROM_EMAIL=reports@leadstrategus.com

# ── Site-wide maintenance kill switch ────────────────────────────────
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# ── Misc ─────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
